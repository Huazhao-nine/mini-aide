import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error
import os

# 设置随机种子保证可重复性
np.random.seed(42)

# 创建输出目录
os.makedirs('./working', exist_ok=True)

# 1. 读取数据
train_df = pd.read_csv('/home/huazhao/DL-HW/ML-2025/mini-aide/input/train.csv')
test_df = pd.read_csv('/home/huazhao/DL-HW/ML-2025/mini-aide/input/test.csv')

# 2. 准备特征和目标列
# 禁止使用的列
forbidden_features = ['id', 'tested_positive_day3', 'tested_positive_day1', 'tested_positive_day2']

# 定义特征列和目标列
feature_cols = [col for col in train_df.columns if col not in forbidden_features]
target_col = 'tested_positive_day3'

# 准备训练数据
X = train_df[feature_cols].copy()
y = train_df[target_col].copy()

# 准备测试数据
X_test = test_df[feature_cols].copy()

# 3. 5折交叉验证
kf = KFold(n_splits=5, shuffle=True, random_state=42)
oof_predictions = np.zeros(len(train_df))
test_predictions = np.zeros(len(test_df))

for fold, (train_idx, val_idx) in enumerate(kf.split(X, y)):
    print(f"Fold {fold+1}/5")
    
    # 划分训练和验证集
    X_train_fold, X_val_fold = X.iloc[train_idx], X.iloc[val_idx]
    y_train_fold, y_val_fold = y.iloc[train_idx], y.iloc[val_idx]
    
    # 初始化模型（随机森林作为稳健baseline）
    model = RandomForestRegressor(
        n_estimators=100,
        max_depth=None,
        min_samples_split=2,
        min_samples_leaf=1,
        random_state=42,
        n_jobs=-1
    )
    
    # 训练
    model.fit(X_train_fold, y_train_fold)
    
    # 验证集预测
    oof_predictions[val_idx] = model.predict(X_val_fold)
    
    # 测试集预测（fold平均）
    test_predictions += model.predict(X_test) / 5

# 4. 计算最终OOF MSE
final_mse = mean_squared_error(y, oof_predictions)
print(f"OOF MSE: {final_mse:.6f}")

# 5. 生成测试集提交文件
submission = pd.DataFrame({
    'id': test_df['id'],
    'tested_positive_day3': test_predictions
})
submission.to_csv('./working/submission.csv', index=False)
print(f"Submission saved to ./working/submission.csv")

# 6. 输出最终结果（必须为最后一行）
print(f"FINAL_MSE={final_mse:.6f}")
