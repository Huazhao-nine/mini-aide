根据任务要求，我将从零开始构建一个稳健的基线模型。考虑到数据特性（表格数据、相对较小的样本量），我选择使用LightGBM回归模型，因为它能很好地处理数值特征且不易过拟合。我会按照严格交叉验证要求实现，确保结果可靠。

```python
import numpy as np
import pandas as pd
import warnings
warnings.filterwarnings('ignore')

from sklearn.model_selection import KFold
from sklearn.metrics import mean_squared_error
from sklearn.preprocessing import StandardScaler
import lightgbm as lgb

# ========== 1. 数据加载与预处理 ==========
print("正在加载数据...")
train_df = pd.read_csv('/home/huazhao/DL-HW/ML-2025/mini-aide/input/train.csv')
test_df = pd.read_csv('/home/huazhao/DL-HW/ML-2025/mini-aide/input/test.csv')

# 分离特征和目标
target_col = 'tested_positive_day3'

# 确定特征列：排除id和目标列
feature_cols = [col for col in train_df.columns 
                if col not in ['id', target_col]]

X = train_df[feature_cols].copy()
y = train_df[target_col].copy()

X_test = test_df[feature_cols].copy()

print(f"训练集形状: {X.shape}, 测试集形状: {X_test.shape}")

# ========== 2. 处理缺失值 ==========
# 检查并填充缺失值
for df in [X, X_test]:
    for col in df.columns:
        if df[col].isnull().any():
            mean_val = X[col].mean()  # 仅用训练集的统计量
            df[col] = df[col].fillna(mean_val)
            print(f"列 '{col}' 有 {df[col].isnull().sum()} 个缺失值，用均值 {mean_val:.3f} 填充")

# ========== 3. 5折交叉验证训练 ==========
print("\n开始5折交叉验证训练...")
n_folds = 5
kf = KFold(n_splits=n_folds, shuffle=True, random_state=42)

# 存储OOF预测和模型
oof_predictions = np.zeros(len(X))
models = []

# LightGBM参数（稳健的基线参数）
params = {
    'objective': 'regression',
    'metric': 'mse',
    'boosting_type': 'gbdt',
    'n_estimators': 500,
    'learning_rate': 0.05,
    'num_leaves': 31,  # 较小值防止过拟合
    'max_depth': 6,
    'min_child_samples': 20,
    'subsample': 0.8,
    'colsample_bytree': 0.8,
    'reg_alpha': 0.1,    # L1正则化
    'reg_lambda': 0.1,   # L2正则化
    'random_state': 42,
    'n_jobs': -1,
    'verbose': -1
}

for fold, (train_idx, val_idx) in enumerate(kf.split(X, y)):
    print(f"\n--- 训练第 {fold+1}/{n_folds} 折 ---")
    
    # 划分训练集和验证集
    X_train_fold, X_val_fold = X.iloc[train_idx], X.iloc[val_idx]
    y_train_fold, y_val_fold = y.iloc[train_idx], y.iloc[val_idx]
    
    # 训练模型
    model = lgb.LGBMRegressor(**params)
    model.fit(
        X_train_fold, y_train_fold,
        eval_set=[(X_val_fold, y_val_fold)],
        eval_metric='mse',
        early_stopping_rounds=50,
        verbose=False
    )
    
    # 验证集预测
    val_pred = model.predict(X_val_fold)
    oof_predictions[val_idx] = val_pred
    
    # 计算当前折的MSE
    fold_mse = mean_squared_error(y_val_fold, val_pred)
    print(f"第 {fold+1} 折验证集MSE: {fold_mse:.6f}")
    
    models.append(model)

# ========== 4. 计算OOF MSE ==========
oof_mse = mean_squared_error(y, oof_predictions)
print(f"\n{'='*50}")
print(f"5折交叉验证OOF MSE: {oof_mse:.6f}")
print(f"{'='*50}")

# ========== 5. 测试集预测 ==========
print("\n生成测试集预测...")
test_predictions = np.zeros(len(X_test))

# 使用